# Esophageal Motility Manometry Agent - Environment Configuration
# Copy this file to .env and customize for your deployment

# HMAC-SHA256 Audit Trail Secret Key
# Set this to a persistent, cryptographically secure random value for production.
# If not set, a random ephemeral key is generated (audit trail won't persist across restarts).
AUDIT_SECRET_KEY=your-secure-random-key-here
